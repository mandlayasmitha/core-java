import java.util.Scanner;

class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.println("Enter String: ");
        String s = sc.nextLine();

        String o = new String("hlo");
        System.out.println(s + " " + o);

        String o1 = new String("Yashu");

        // 1. charAt()
        for (int i = 0; i < o1.length(); i++) {
            System.out.println(o1.charAt(i));
        }

        // 2. length()
        System.out.println("Length: " + o1.length());

        // 3. toUpperCase()
        System.out.println("Uppercase: " + o1.toUpperCase());

        // 4. toLowerCase()
        System.out.println("Lowercase: " + o1.toLowerCase());

        // 5. substring()
        System.out.println("Substring: " + o1.substring(1, 4));

        // 6. equals()
        System.out.println("Equals: " + o1.equals("Yashu"));

        // 7. equalsIgnoreCase()
        System.out.println("Equals Ignore Case: " +
                           o1.equalsIgnoreCase("yashu"));

        // 8. contains()
        System.out.println("Contains: " + o1.contains("ash"));

        // 9. startsWith()
        System.out.println("Starts With: " + o1.startsWith("Ya"));

        // 10. endsWith()
        System.out.println("Ends With: " + o1.endsWith("hu"));

        // 11. indexOf()
        System.out.println("Index Of: " + o1.indexOf('a'));

        // 12. lastIndexOf()
        System.out.println("Last Index Of: " + o1.lastIndexOf('a'));

        // 13. replace()
        System.out.println("Replace: " + o1.replace('a', 'o'));

        // 14. concat()
        System.out.println("Concat: " + o1.concat(" Mandla"));

        // 15. trim()
        String str = "  Hello Java  ";
        System.out.println("Trim: " + str.trim());

        // 16. isEmpty()
        System.out.println("Is Empty: " + o1.isEmpty());

        // 17. isBlank()
        System.out.println("Is Blank: " + o1.isBlank());

        // 18. repeat()
        System.out.println("Repeat: " + o1.repeat(2));

        // 19. replaceAll()
        System.out.println("Replace All: " +
                           o1.replaceAll("a", "o"));

        // 20. replaceFirst()
        System.out.println("Replace First: " +
                           o1.replaceFirst("a", "o"));

        // 21. strip()
        System.out.println("Strip: " + str.strip());

        // 22. stripLeading()
        System.out.println("Strip Leading: " + str.stripLeading());

        // 23. stripTrailing()
        System.out.println("Strip Trailing: " + str.stripTrailing());

        // 24. toCharArray()
        char[] arr = o1.toCharArray();
        System.out.println("To Char Array:");
        for (char c : arr) {
            System.out.println(c);
        }

        // 25. compareTo()
        System.out.println("Compare To: " + o1.compareTo("Yashu"));

        // 26. compareToIgnoreCase()
        System.out.println("Compare Ignore Case: " +
                           o1.compareToIgnoreCase("yashu"));

        // 27. matches()
        System.out.println("Matches: " + o1.matches("Yashu"));

        // 28. split()
        String str1 = "Java Python C";
        String[] words = str1.split(" ");

        System.out.println("Split:");
        for (String word : words) {
            System.out.println(word);
        }

        // 29. join()
        System.out.println("Join: " +
                           String.join("-", "Java", "Python", "C"));

        // 30. valueOf()
        int n = 100;
        String result = String.valueOf(n);
        System.out.println("Value Of: " + result);

        // 31. intern()
        String result1 = o1.intern();
        System.out.println("Intern: " + result1);

        sc.close();
    }
}

